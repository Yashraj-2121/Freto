{
  "name": "freto-mern",
  "private": true,
  "version": "1.0.0",
  "description": "FRETO FreightFlow — Full-Stack Freight & Truck Booking Platform (MERN Stack: MongoDB + Express + React + Node.js)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:optimizer": "dotnet run --project services/Freto.RouteOptimizer",
    "build:optimizer": "dotnet build services/Freto.RouteOptimizer",
    "test:optimizer": "dotnet test services/Freto.RouteOptimizer.Tests",
    "seed": "npm run seed --workspace server",
    "db:view": "node server/src/scripts/viewDb.js",
    "build": "npm run build --workspace client"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}

# --- PostgreSQL (core transactional data) ---
POSTGRES_URL="postgresql://freto:freto_dev_password@localhost:5432/freto"

# --- MySQL (notification delivery log, deliberately isolated) ---
MYSQL_URL="mysql://freto:freto_dev_password@localhost:3306/freto_notifications"

# --- MongoDB (GPS tracking pings + audit log) ---
MONGO_URL="mongodb://localhost:27017/freto"

# --- Redis (OTP store + Socket.io cross-instance pub/sub) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-access-token-secret"
JWT_REFRESH_SECRET="change-me-refresh-token-secret"

# --- App URLs ---
APP_URL="http://localhost:3000"
PORT=4000

# --- SMS / OTP provider ---
SMS_PROVIDER="msg91"
SMS_API_KEY=""
SMS_SENDER_ID="FRETO"

# --- File storage (S3-compatible) ---
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="freto-documents"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Payments ---
PAYMENTS_PROVIDER="razorpay"
PAYMENTS_KEY_ID=""
PAYMENTS_KEY_SECRET=""
PAYMENTS_WEBHOOK_SECRET=""

NODE_ENV="development"
